# NS API key: create an account at https://apiportal.ns.nl, subscribe to the "Ns-App" product,
# and copy the primary key. Without it, stations come from OpenStreetMap and train times are unavailable.
NS_API_KEY=
DATABASE_PATH=data/treinwandelaar.db
# Visitors without an Authentik username (X-authentik-username): 'full' sees everything as one shared
# user (local dev, LAN-only); 'demo' (the default) sees only the OpenStreetMap walks and can't save.
ANONYMOUS_ACCESS=full
# Default home station (NS code), e.g. UT = Utrecht Centraal
HOME_STATION=UT
