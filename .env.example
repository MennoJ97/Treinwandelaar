# NS API key: create an account at https://apiportal.ns.nl, subscribe to the "Ns-App" product,
# and copy the primary key. Without it, stations come from OpenStreetMap and train times are unavailable.
NS_API_KEY=
DATABASE_PATH=data/treinwandelaar.db
# Visitors without an Authentik username (X-authentik-username): 'full' sees everything as one shared
# user (local dev, LAN-only); 'demo' (the default) sees only the OpenStreetMap walks and can't save.
ANONYMOUS_ACCESS=full
# Optional: shared with the reverse proxy, which must send it as X-Proxy-Secret on every request
# (`openssl rand -hex 32`). When set, X-authentik-username is only believed on requests that carry it.
PROXY_SECRET=
# Default home station (NS code), e.g. UT = Utrecht Centraal
HOME_STATION=UT

# Optional: origin of the site this app belongs to (e.g. https://example.org). It serves family.css,
# family.js and the link-preview image, and the header links back to it. Without it the app uses its
# own greys and type, with the light/dark mode following your system.
FAMILY_SITE=
