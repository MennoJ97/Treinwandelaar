{
	"name": "treinwandelaar",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"ingest:stations": "tsx --env-file-if-exists=.env scripts/ingest/stations.ts",
		"ingest:wandelnet": "tsx --env-file-if-exists=.env scripts/ingest/wandelnet.ts",
		"ingest:nsnl": "tsx --env-file-if-exists=.env scripts/ingest/nsnl.ts",
		"ingest": "npm run ingest:stations && npm run ingest:wandelnet && npm run ingest:nsnl"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"node-html-parser": "^9.0.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/overpass": "^5.3.0",
		"maplibre-gl": "^6.14.0"
	}
}
